{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "state.schema.json",
	"title": "Estado de uma execução #qa-run",
	"type": "object",
	"required": ["card", "state", "createdAt", "updatedAt", "history", "gates", "automationCycles"],
	"properties": {
		"card": { "type": "string" },
		"state": {
			"enum": ["DISCOVERY", "ALIGNMENT", "BDD", "AWAITING_G1", "ZEPHYR", "AWAITING_G2", "AUTOMATION_DECISION", "AUTOMATION", "RUN", "REPORT", "AWAITING_G3", "DELIVERY", "DONE"]
		},
		"createdAt": { "type": "string" },
		"updatedAt": { "type": "string" },
		"automationCycles": { "type": "integer", "minimum": 0 },
		"discovery": {
			"type": "object",
			"required": ["mode", "artifact", "sha256", "recordedAt"],
			"properties": {
				"mode": { "enum": ["complete", "without-code", "documental"] },
				"artifact": { "type": "string" },
				"sha256": { "type": "string" },
				"recordedAt": { "type": "string" }
			}
		},
		"history": {
			"type": "array",
			"items": {
				"type": "object",
				"required": ["from", "to", "at"],
				"properties": { "from": { "type": "string" }, "to": { "type": "string" }, "at": { "type": "string" }, "note": { "type": "string" } }
			}
		},
		"gates": {
			"type": "object",
			"additionalProperties": {
				"type": "object",
				"required": ["by", "at"],
				"properties": {
					"by": { "type": "string" },
					"at": { "type": "string" },
					"artifact": { "type": "string" },
					"sha256": { "type": "string" },
					"runId": { "type": "string" },
					"validation": {
						"type": "object",
						"required": ["schemaVersion", "checksSha256"],
						"properties": {
							"schemaVersion": { "const": 1 },
							"checksSha256": { "type": "string" }
						}
					}
				}
			}
		}
	}
}
