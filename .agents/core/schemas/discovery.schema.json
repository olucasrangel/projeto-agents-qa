{
  "$id": "discovery.schema.json",
  "title": "Manifesto de fontes do discovery",
  "type": "object",
  "required": ["schemaVersion", "card", "mode", "recordedAt", "sources", "limitations", "hypotheses"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "card": { "type": "string", "pattern": "^[A-Z][A-Z0-9]+-[0-9]+$" },
    "mode": { "enum": ["complete", "without-code", "documental"] },
    "recordedAt": { "type": "string" },
    "sources": {
      "type": "object",
      "required": ["jira", "confluence", "screen", "code"],
      "properties": {
        "jira": { "$ref": "#/$defs/source" },
        "confluence": { "$ref": "#/$defs/source" },
        "screen": { "$ref": "#/$defs/source" },
        "code": { "$ref": "#/$defs/source" }
      },
      "additionalProperties": false
    },
    "limitations": { "type": "array", "items": { "type": "string" } },
    "hypotheses": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "source": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": { "enum": ["complete", "partial", "unavailable", "not-accessed", "not-authorized"] },
        "artifact": { "type": "string" },
        "reason": { "type": "string" },
        "repositories": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    }
  }
}
