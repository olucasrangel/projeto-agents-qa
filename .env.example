# Copie este arquivo para .env e preencha com valores reais.
# O .env é ignorado pelo git (ver .gitignore) e não deve ser versionado.

# Token Zephyr Scale
ZEPHYR_SCALE_API_TOKEN=
ZEPHYR_BASE_URL=https://api.zephyrscale.smartbear.com/v2
# Credenciais do Coordenador em stage (obrigatórias)
ERP_STAGE_COORD_USERNAME=
ERP_STAGE_COORD_PASSWORD=

# Credenciais do aluno no AVA HML (preencha localmente; nunca versione)
LMS_HML_USERNAME=
LMS_HML_PASSWORD=

# Opcionais — descomente para sobrescrever os padrões (ver README do sistema)
# E2E_PROJECT=erp-academico
# E2E_EVIDENCE=1
# E2E_RUN_ID=execucao-local-001
# E2E_QB_EXPENSIVE=1

# O launcher do MCP SmartBear carrega este segredo do .env local.
ZEPHYR_API_TOKEN=
# ZEPHYR_BASE_URL=https://api.zephyrscale.smartbear.com/v2
